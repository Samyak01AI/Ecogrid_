{
  "name": "@ecogrid/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "prisma generate --schema prisma/postgres/schema.prisma && prisma generate --schema prisma/mysql/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:migrate:mysql": "prisma migrate deploy --schema prisma/mysql/schema.prisma",
    "seed": "tsx src/seed.ts",
    "seed:prod": "node dist/seed.js"
  },
  "dependencies": {
    "@ecogrid/contracts": "workspace:*",
    "@ecogrid/domain": "workspace:*",
    "@fastify/cookie": "10.0.1",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/static": "8.0.4",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.2",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "fastify": "5.2.1",
    "jose": "5.9.6",
    "pdfkit": "0.16.0",
    "prisma": "6.19.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/pdfkit": "0.13.9",
    "tsx": "4.19.3"
  }
}
