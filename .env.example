# -----------------------------------------------------------------------------
# EcoGrid AI — Environment Configuration Template
# -----------------------------------------------------------------------------

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://ecogrid:ecogrid@localhost:5432/ecogrid

# Networking & Service Ports
API_PORT=3001
PORT=3000
NODE_ENV=development

# Deployment Origins & CORS
# Set WEB_ORIGIN to your frontend URL (e.g. https://your-app.vercel.app in production)
WEB_ORIGIN=http://localhost:3000
# Set to 'true' in production HTTPS so cookies are marked Secure and SameSite=None
PUBLIC_HTTPS=false

# Session & Authentication Security
# Generate a cryptographically strong 64-character secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-random-secret-of-at-least-32-chars
SESSION_COOKIE_NAME=ecogrid_session
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=ecogrid_csrf

# Rate Limiting (Brute-Force Prevention)
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# Bootstrap Initial Administrator
# On startup, an initial admin user is created if no admin exists in the database.
SEED_ADMIN_EMAIL=admin@ecogrid.internal
SEED_ADMIN_PASSWORD=replace-with-a-secure-bootstrap-password-12char!

# Email Delivery for Password Reset & Verification (Optional)
# In local development without SMTP, password reset returns a dev_reset_token for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ecogrid.org
SMTP_TLS=true

# Optional: trained-model service the API can fetch scores and confidence from (see model-service/).
# Leave MODEL_URL empty to keep using the built-in deterministic scores.
MODEL_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_MS=8000

# Grok (xAI) Multi-API Key Pool (at least 5 keys with automatic failover & switching)
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=
GROK_API_KEY_4=
GROK_API_KEY_5=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
