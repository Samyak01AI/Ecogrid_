# Local Docker uses PostgreSQL. Hosted Webdev uses its managed MySQL-compatible database URL.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://ecogrid:ecogrid@localhost:5432/ecogrid
API_PORT=3001
PORT=3000
WEB_ORIGIN=http://localhost:3000
PUBLIC_HTTPS=false
ECOGRID_JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ECOGRID_JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SEED_ADMIN_EMAIL=planner@example.test
SEED_ADMIN_PASSWORD=replace-this-before-seeding
NODE_ENV=development

# Optional: trained-model service the API can fetch scores and confidence from (see model-service/).
# Leave MODEL_URL empty to keep using the built-in deterministic scores.
MODEL_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_MS=8000
